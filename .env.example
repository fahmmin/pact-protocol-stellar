DAILY_CHECK_HOUR_UTC=0
DEFAULT_KPI_THRESHOLD_BPS=500
INDEXER_MAX_DEALS=50
PACT_EDITION=oss
PRO_API_KEY=
PRO_WEBHOOK_URL=

# ── FRONTEND ──────────────────────────────────────────────────────────
NEXT_PUBLIC_NETWORK=testnet
